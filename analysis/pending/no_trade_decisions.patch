+# ---------------- 合成資料庫情境 ----------------
+def _db(tmp_path, sql=(), add_cols=True):
+    tmp_path.mkdir(parents=True, exist_ok=True)
+    p = SD.build_sqlite(tmp_path / "nt.db")
+    con = sqlite3.connect(p)
+    have = {r[1] for r in con.execute("PRAGMA table_info(daily_prices)")}
+    if add_cols:
+        for c, t in (("is_no_trade", "INTEGER"), ("change_note", "TEXT"), ("next_ref_price_twd", "REAL")):
+            if c not in have:
+                con.execute(f"ALTER TABLE daily_prices ADD COLUMN {c} {t}")
+    for q, args in sql:
+        con.execute(q, args)
+    con.commit()
+    con.close()
+    return p
+
+
+def _upd(sym, d, **kv):
+    return (f"UPDATE daily_prices SET {', '.join(f'{k} = ?' for k in kv)} WHERE symbol = ? AND price_date = ?",
+            [*kv.values(), sym, d])
+
+
+NO_TRADE = dict(open_twd=None, high_twd=None, low_twd=None, close_twd=None, volume_shares=0, amount_twd=0,
+                change_twd=None, change_sign=None)
+
+
+def _summary(p, as_of=AS_OF, **kw):
+    inp = I.load_screen_inputs(p, as_of=as_of)
+    return S.screen(**inp.screen_kwargs(), **kw).summary.set_index("symbol")
+
+
+def _vi(p, as_of=AS_OF):
+    data = VI.load_db(p, as_of=as_of)
+    return VI.recompute(data, S.ScreenParams().to_dict(), sorted(data["secs"]))
+
