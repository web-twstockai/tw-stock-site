+    s = _summary(p).loc["TEST01"]
+    assert s["exclusion_code"] == "EXCL_BAD_DATA" and "有收盤價但成交量缺漏（NULL）（視窗內" in s["exclusion_reason"]
+    assert (s["window_bad_data_days"], s["window_no_trade_days"], s["window_gap_days"]) == (1, 0, 1)   # 合計不變
+    v = _vi(p)["TEST01"]
