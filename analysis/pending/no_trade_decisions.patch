+# ---------------- 純函式 ----------------
+def test_row_kind():
+    assert A.row_kind(10.0, 1000) == "valid"
+    assert A.row_kind(10.0, None) == "bad_volume" and A.row_kind(10.0, float("nan")) == "bad_volume"
+    assert A.row_kind(None, 0) == "no_trade" and A.row_kind(None, 5) == "no_trade"      # 只有零股成交
+    assert A.row_kind(10.0, 0) == "no_trade" and A.row_kind(None, None) == "no_trade"
+
+
+def test_no_trade_flag_conflict():
+    assert A.no_trade_flag_conflict(10.0, 1000, 1) == "is_no_trade＝1 但價量顯示有成交"
+    assert A.no_trade_flag_conflict(None, 0, 0).startswith("is_no_trade＝0 但價量顯示整股無成交")
+    assert A.no_trade_flag_conflict(10.0, 1000, 0) is None and A.no_trade_flag_conflict(None, 0, 1) is None
+    assert A.no_trade_flag_conflict(10.0, 1000, None) is None                    # 旗標未知不比對
+    assert A.no_trade_flag_conflict(10.0, None, 1) is None                       # 資料錯誤列不比對
+
+
+def test_check_change_after_no_trade_pure():
+    f = A.check_change_after_no_trade
+    st, src, diff, tol, note = f(11.60, 11.00, None, "X")
+    assert (st, src, diff) == ("after_no_trade", None, None) and note.startswith("無比價")
+    st, *_, note = f(11.60, 11.00, None, None, change_note="無比價")
+    assert st == "after_no_trade" and "無比價" in note
+    # TPEx 2064 實例數字（官方次日參考價 10.95、漲跌 +0.65）：有參考價→一致
+    st, src, diff, tol, note = f(11.60, 11.00, 0.65, "+", official_ref=10.95)
+    assert st == "after_no_trade" and src == pytest.approx(0.65) and abs(diff) < 1e-9 and tol == 0.005
+    assert "依官方參考價 10.95 比對一致" in note
+    st, _, diff, _, note = f(11.60, 11.00, 0.65, "+", official_ref=10.90)
+    assert st == "mismatch" and diff == pytest.approx(0.05) and "不一致" in note
+    # 無官方參考價：不比對、不算 mismatch，列出隱含參考價
+    st, src, diff, tol, note = f(11.60, 11.00, 0.65, "+")
+    assert (st, diff, tol) == ("after_no_trade", None, None) and "隱含參考價 10.95" in note
+    assert f(11.60, 11.00, 0.65, "-")[0] == "after_no_trade"                    # 帶號 −0.65
+    assert f(11.60, 11.00, -0.65, "+")[0] == "source_sign_conflict"
+    st, *_, note = f(11.60, 11.00, None, None)
+    assert st == "after_no_trade" and "官方未提供漲跌" in note
+    assert "after_no_trade" in A.CHANGE_CHECK_STATUSES
+
