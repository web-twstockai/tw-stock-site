diff -ruN -x __pycache__ -x .pytest_cache base/analysis/tests/test_coverage_scope.py work/analysis/tests/test_coverage_scope.py
--- a/analysis/tests/test_coverage_scope.py	1970-01-01 08:00:00.000000000 +0800
+++ b/analysis/tests/test_coverage_scope.py	2026-11-17 20:00:22.840736640 +0800
@@ -0,0 +1,174 @@
+"""analysis-0.9.1 重做：除權息覆蓋表 scope（docs/indicators.md 第 10.5 節；專案負責人核可 2026-11-17 19:41）。只用測試用合成資料。
+資料庫有 scope 欄時：全市場評估（預設 coverage_scope='all'，守保）只接受 scope='all'；追蹤清單（coverage_scope='tracked'，須給 symbols）
+接受 sample30 或 all；其他值（all_pending_ratio、subset、NULL…）都不算齊全，當作無覆蓋走 strict 排除碼。沒有 scope 欄時維持現狀。"""
+import sqlite3
+
+import pytest
+
+import io_sqlite as I
+import screener as S
+import synthetic_data as SD
+import verify_independent as VI
+
+AS_OF = "2026-10-05"
+SYM = "TEST01"
+
+
+FIX1_DDL = ("CREATE TABLE corporate_actions_coverage (market TEXT NOT NULL, action_kind TEXT NOT NULL, coverage_start TEXT NOT NULL, "
+            "coverage_end TEXT NOT NULL, source TEXT NOT NULL, fetched_at TEXT NOT NULL, notes TEXT, "
+            "scope TEXT NOT NULL DEFAULT 'unknown', symbol_count INTEGER, "
+            "PRIMARY KEY(market, action_kind, coverage_start, coverage_end, source, scope))")   # 管線 3b_fix1 形狀（主鍵含 scope）
+TRACKED = [f"TEST{i:02d}" for i in range(1, 34)]
+
+
+def _db(tmp_path, scope="all", by_kind=None, column=True, extra_scopes=(), members=tuple(TRACKED)):
+    """column=True：覆蓋表重建成 fix1 形狀；每列 scope＝scope（None 時用舊 3b 形狀以便寫 NULL），
+    by_kind 個別改某類別；extra_scopes：同一區間再多寫幾列不同 scope（主鍵含 scope，可並存）。
+    members：universe_members sample30 的代號（None＝不建表／刪表）。"""
+    tmp_path.mkdir(parents=True, exist_ok=True)
+    p = SD.build_sqlite(tmp_path / "c.db")
+    con = sqlite3.connect(p)
+    cols = [r[1] for r in con.execute("PRAGMA table_info(corporate_actions_coverage)")]
+    base = con.execute("SELECT market, action_kind, coverage_start, coverage_end, source, fetched_at "
+                       "FROM corporate_actions_coverage").fetchall()
+    if not column:
+        if "scope" in cols:                              # 3b／fix1 形狀：scope 在主鍵內不能 DROP COLUMN → 以舊形狀重建
+            con.execute("DROP TABLE corporate_actions_coverage")
+            con.execute(FIX1_DDL.replace("scope TEXT NOT NULL DEFAULT 'unknown', ", "").replace(", source, scope))", ", source))"))
+            con.executemany("INSERT INTO corporate_actions_coverage VALUES (?,?,?,?,?,?,NULL,NULL)", base)
+    else:
+        con.execute("DROP TABLE corporate_actions_coverage")
+        con.execute(FIX1_DDL if scope is not None else FIX1_DDL.replace("scope TEXT NOT NULL DEFAULT 'unknown'", "scope TEXT")
+                    .replace(", source, scope))", ", source))"))
+        for r in base:
+            sc = (by_kind or {}).get(r[1], scope)
+            con.execute("INSERT INTO corporate_actions_coverage VALUES (?,?,?,?,?,?,NULL,?,NULL)", (*r, sc))
+            for ex in extra_scopes:
+                con.execute("INSERT INTO corporate_actions_coverage VALUES (?,?,?,?,?,?,NULL,?,NULL)", (*r, ex))
+    con.execute("DROP TABLE IF EXISTS universe_members")
+    if members is not None:
+        con.execute("CREATE TABLE universe_members (universe_id TEXT NOT NULL, symbol TEXT NOT NULL, market TEXT, "
+                    "included INTEGER NOT NULL, exclude_reason TEXT, as_of TEXT NOT NULL, source TEXT, fetched_at TEXT NOT NULL, "
+                    "PRIMARY KEY (universe_id, symbol))")
+        con.executemany("INSERT INTO universe_members VALUES ('sample30', ?, NULL, 1, NULL, '2026-11-17', 'test', 'x')",
+                        [(m,) for m in members])
+    con.commit()
+    con.close()
+    return p
+
+
+def _res(p, **kw):
+    inp = I.load_screen_inputs(p, as_of=AS_OF, **kw)
+    return inp, S.screen(**inp.screen_kwargs())
+
+
+def _sym(r):
+    return r.summary.set_index("symbol").loc[SYM]
+
+
+def test_no_scope_column_unchanged(tmp_path):
+    p = _db(tmp_path, column=False)
+    inp, r = _res(p)
+    assert inp.coverage_scope_note is None and r.coverage_scope_note is None and inp.coverage_status == "ok"
+    assert _sym(r)["status"] == "PASS"
+    assert "覆蓋表 scope" not in str(_sym(r)["data_note"])
+
+
+def test_all_scope_accepted_full_market(tmp_path):
+    inp, r = _res(_db(tmp_path, "all"))
+    assert _sym(r)["status"] == "PASS"
+    assert "評估範圍＝全市場，只接受 all" in r.coverage_scope_note and "不採用" not in inp.coverage_scope_note
+    assert "覆蓋表 scope" not in str(_sym(r)["data_note"])          # 通過覆蓋檢查的列不加註（範圍寫在 ScreenResult）
+
+
+@pytest.mark.parametrize("val", ["sample30", "all_pending_ratio", "subset", "unknown", None, "ALL"])
+def test_full_market_rejects_non_all(tmp_path, val):
+    inp, r = _res(_db(tmp_path, val))
+    s = _sym(r)
+    assert inp.coverage_status == "coverage_scope_none_accepted"
+    assert s["exclusion_code"] == "EXCL_ADJ_COVERAGE_GAP"
+    assert f"不採用" in s["data_note"] and (val or "NULL") in inp.coverage_scope_note
+
+
+def test_tracked_accepts_sample30_and_all(tmp_path):
+    for val in ("sample30", "all"):
+        inp, r = _res(_db(tmp_path / val, val), symbols=[SYM], coverage_scope="tracked")
+        assert _sym(r)["status"] == "PASS"
+        assert "評估範圍＝追蹤清單，只接受 sample30／all" in r.coverage_scope_note
+
+
+@pytest.mark.parametrize("val", ["all_pending_ratio", "subset", "unknown", None])
+def test_tracked_rejects_others(tmp_path, val):
+    inp, r = _res(_db(tmp_path, val), symbols=[SYM], coverage_scope="tracked")
+    assert _sym(r)["exclusion_code"] == "EXCL_ADJ_COVERAGE_GAP"
+
+
+def test_partial_kind_rejected_means_gap(tmp_path):
+    p = _db(tmp_path, "all", by_kind={"capital_reduction_restore": "all_pending_ratio"})
+    inp, r = _res(p)
+    s = _sym(r)
+    assert s["exclusion_code"] == "EXCL_ADJ_COVERAGE_GAP" and "capital_reduction" in s["coverage_note"]
+    assert inp.coverage_status == "ok" and "不採用 1 列（all_pending_ratio 1" in inp.coverage_scope_note
+
+
+def test_parameter_validation(tmp_path):
+    p = _db(tmp_path, "all")
+    with pytest.raises(ValueError):
+        I.load_screen_inputs(p, as_of=AS_OF, coverage_scope="tracked")          # 追蹤清單必須給 symbols
+    with pytest.raises(ValueError):
+        I.load_screen_inputs(p, as_of=AS_OF, coverage_scope="sample30")
+    df, st = I.load_coverage(sqlite3.connect(p))                                   # 舊介面仍回 2 個值
+    assert st == "ok" and len(df)
+
+
+def test_symbol_inputs_pass_scope(tmp_path):
+    p = _db(tmp_path, "sample30")
+    assert len(I.load_symbol_inputs(p, SYM, as_of=AS_OF)["actions_coverage"]) == 0
+    assert len(I.load_symbol_inputs(p, SYM, as_of=AS_OF, coverage_scope="tracked")["actions_coverage"]) > 0
+
+
+@pytest.mark.parametrize("scope,mode", [("sample30", "all"), ("sample30", "tracked"), ("all_pending_ratio", "tracked")])
+def test_vi_agreement(tmp_path, scope, mode):
+    p = _db(tmp_path, scope)
+    syms = None if mode == "all" else TRACKED
+    st = VI.run_comparison(p, n_dates=2, coverage_scope=mode, symbols=syms)
+    assert st["mismatches"] == [] and st["rows"] > 0
+
+
+def test_same_interval_multiple_scope_rows(tmp_path):
+    # fix1：主鍵含 scope，同一區間可同時有 sample30／subset／unknown 與 all 列
+    p = _db(tmp_path / "a", "sample30", extra_scopes=("subset", "unknown"))
+    _, r = _res(p)
+    assert _sym(r)["exclusion_code"] == "EXCL_ADJ_COVERAGE_GAP"                     # 全市場：沒有 all 列
+    _, r = _res(p, symbols=[SYM], coverage_scope="tracked")
+    assert _sym(r)["status"] == "PASS"                                              # 追蹤清單：sample30 可用
+    p2 = _db(tmp_path / "b", "all", extra_scopes=("sample30", "subset", "unknown"))
+    inp, r = _res(p2)
+    assert _sym(r)["status"] == "PASS"
+    assert "採用 9 列，不採用 27 列（sample30 9、subset 9、unknown 9" in inp.coverage_scope_note
+    inp, r = _res(p2, symbols=[SYM], coverage_scope="tracked")                      # 同區間 all＋sample30 兩列合併後照常可用
+    assert _sym(r)["status"] == "PASS" and "採用 18 列" in inp.coverage_scope_note
+    p3 = _db(tmp_path / "c", "unknown", extra_scopes=("subset", "all_pending_ratio"))
+    for kw in ({}, {"symbols": [SYM], "coverage_scope": "tracked"}):
+        inp, r = _res(p3, **kw)
+        assert inp.coverage_status == "coverage_scope_none_accepted" and _sym(r)["exclusion_code"] == "EXCL_ADJ_COVERAGE_GAP"
+
+
+def test_tracked_requires_universe_members(tmp_path):
+    p = _db(tmp_path / "a", "sample30", members=None)                                # 表不存在 → 保守只認 all
+    inp, r = _res(p, symbols=[SYM], coverage_scope="tracked")
+    assert _sym(r)["exclusion_code"] == "EXCL_ADJ_COVERAGE_GAP" and "universe_members 無追蹤清單" in inp.coverage_scope_note
+    p = _db(tmp_path / "b", "sample30", members=("TEST02",))                         # 代號不在追蹤清單 → 只認 all
+    inp, r = _res(p, symbols=[SYM], coverage_scope="tracked")
+    assert _sym(r)["exclusion_code"] == "EXCL_ADJ_COVERAGE_GAP" and "1 檔不在追蹤清單" in inp.coverage_scope_note
+    p = _db(tmp_path / "c", "all", members=None)                                     # all 列不受影響
+    _, r = _res(p, symbols=[SYM], coverage_scope="tracked")
+    assert _sym(r)["status"] == "PASS"
+    assert I.tracked_members(sqlite3.connect(_db(tmp_path / "d", "all"))) == frozenset(TRACKED)
+
+
+@pytest.mark.parametrize("members", [None, ("TEST02",)])
+def test_vi_agreement_universe(tmp_path, members):
+    p = _db(tmp_path, "sample30", extra_scopes=("unknown",), members=members)
+    st = VI.run_comparison(p, n_dates=2, coverage_scope="tracked", symbols=TRACKED)
+    assert st["mismatches"] == [] and st["rows"] > 0
diff -ruN -x __pycache__ -x .pytest_cache base/analysis/tests/test_halt_insufficient.py work/analysis/tests/test_halt_insufficient.py
--- a/analysis/tests/test_halt_insufficient.py	1970-01-01 08:00:00.000000000 +0800
+++ b/analysis/tests/test_halt_insufficient.py	2026-11-17 19:51:58.398322582 +0800
@@ -0,0 +1,135 @@
+"""analysis-0.9.1 重做：停牌推定的 insufficient 規則（docs/indicators.md 第 10 節；專案負責人核可 2026-11-17 19:41）。只用測試用合成資料。
+只有推定區間（無官方恢復日）內「整個市場都缺行情」（該市場當日現行列數 < 100）的交易日，停牌日之後本股無資料列才不算停牌，
+改計缺漏（評估日為 EXCL_NO_ROW_SUSPENDED_OR_MISSING）；停牌日當天仍是停牌；全市場當天有資料、只是本股沒有列 → 照原規則算停牌。"""
+import sqlite3
+
+import pandas as pd
+
+import adjust as A
+import io_sqlite as I
+import screener as S
+import synthetic_data as SD
+from test_halt_rule import SYM, _db, _days, _row
+
+T = pd.Timestamp
+
+
+def _days_fixture(tmp_path):
+    return _days(SD.build_sqlite(tmp_path / "d.db"))
+
+
+# ---------------- 純函式 ----------------
+def test_pure_hole_days_not_halt_without_row_but_halt_day_stays():
+    hole = {T("2026-09-02"), T("2026-09-03"), T("2026-09-01")}
+    td = [T("2026-09-01"), T("2026-09-02"), T("2026-09-03"), T("2026-09-04"), T("2026-09-07")]
+    sp = A.resolve_halts([(T("2026-09-01"), None, None)], [T("2026-09-07")], T("2026-09-30"), trade_days=td,
+                         is_hole=lambda d: d in hole)
+    s = sp[0]
+    assert s.source == A.HALT_SRC_TRADE and s.resume == T("2026-09-07")
+    assert s.n_holes == 2 and s.holes == frozenset({T("2026-09-02"), T("2026-09-03")})   # 停牌日當天不算入
+    assert A.is_halt_day(sp, T("2026-09-01"), has_row=False)          # 停牌日當天仍是停牌（即使當天也缺全市場行情）
+    assert not A.is_halt_day(sp, T("2026-09-02"), has_row=False)      # 缺全市場行情 ＋ 本股無列 → 不算停牌
+    assert A.is_halt_day(sp, T("2026-09-02"), has_row=True)           # 本股有（無成交）列 → 仍算停牌
+    assert A.is_halt_day(sp, T("2026-09-04"), has_row=False)          # 全市場有資料、本股無列 → 停牌
+    note = A.halt_note(s)
+    assert A.HALT_SRC_INSUFFICIENT in note and "2 個交易日" in note and "2026-09-02～2026-09-03" in note
+
+
+def test_pure_official_resume_ignores_holes():
+    sp = A.resolve_halts([(T("2026-09-01"), T("2026-09-07"), None)], [], T("2026-09-30"),
+                         trade_days=[T("2026-09-02")], is_hole=lambda d: True)
+    assert sp[0].source == A.HALT_SRC_OFFICIAL and sp[0].n_holes == 0
+    assert A.is_halt_day(sp, T("2026-09-02"), has_row=False)          # 官方恢復日一律照官方，不套 insufficient
+
+
+def test_pure_no_lookahead_holes_only_until_as_of():
+    td = [T("2026-09-02"), T("2026-09-03"), T("2026-09-04")]
+    sp = A.resolve_halts([(T("2026-09-01"), None, None)], [T("2026-09-04")], T("2026-09-03"), trade_days=td,
+                         is_hole=lambda d: True)
+    assert sp[0].source == A.HALT_SRC_ONGOING and sp[0].holes == frozenset({T("2026-09-02"), T("2026-09-03")})
+
+
+# ---------------- 合成資料庫情境（io_sqlite → screener，與 verify_independent 逐值對照） ----------------
+def test_db_market_missing_days_eval_day_no_row(tmp_path):
+    days = _days_fixture(tmp_path)
+    k = days[-3]
+    p = _db(tmp_path / "a", [(k, None)], drop=days[-3:], hole_days=days[-2:])   # 停牌日後兩天整個市場都缺行情
+    s = _row(p)
+    assert s["exclusion_code"] == "EXCL_NO_ROW_SUSPENDED_OR_MISSING"
+    assert "整個市場都缺行情" in s["exclusion_reason"] and A.HALT_SRC_INSUFFICIENT in s["data_note"]
+    assert f"推定區間內 2 個交易日整個市場都缺行情（{days[-2]}～{days[-1]}）" in s["data_note"]
+
+
+def test_db_halt_day_itself_market_missing_is_still_suspended(tmp_path):
+    days = _days_fixture(tmp_path)
+    k = days[-1]
+    s = _row(_db(tmp_path / "b", [(k, None)], drop=[k], hole_days=[k]))
+    assert s["exclusion_code"] == "EXCL_SUSPENDED"
+
+
+def test_db_full_market_but_no_row_is_suspended(tmp_path):
+    days = _days_fixture(tmp_path)
+    k = days[-3]
+    s = _row(_db(tmp_path / "c", [(k, None)], drop=days[-3:]))                   # 全市場有資料、只是本股沒有列
+    assert s["exclusion_code"] == "EXCL_SUSPENDED" and A.HALT_SRC_INSUFFICIENT not in s["exclusion_reason"]
+
+
+def test_db_gap_with_trades_before_and_after(tmp_path):
+    days = _days_fixture(tmp_path)
+    k = days[-10]
+    # 停牌日 k 起 5 天無列；其中第 3、4 天整個市場都缺行情；第 6 天恢復成交（缺口前後都有成交）
+    p = _db(tmp_path / "d", [(k, None)], drop=days[-10:-5], hole_days=days[-8:-6])
+    s = _row(p)
+    assert (s["window_halt_days"], s["window_missing_days"], s["window_gap_days"]) == (3, 2, 5)
+    assert s["exclusion_code"] == "EXCL_WINDOW_GAPS"
+    assert f"恢復日 {days[-5]}（依成交推定）" in s["data_note"] and A.HALT_SRC_INSUFFICIENT in s["data_note"]
+
+
+def test_db_no_lookahead(tmp_path):
+    days = _days_fixture(tmp_path)
+    k = days[-6]
+    # 停牌日後 4 天無列，days[-2] 才恢復成交；days[-5] 與 days[-3] 整個市場都缺行情。評估日 days[-4]：
+    # 之後的成交與之後的缺行情日都不能用 → 仍停牌，缺行情日只算 days[-5] 一天；評估日本身全市場有資料 → 確認停牌
+    p = _db(tmp_path / "e", [(k, None)], drop=days[-6:-2], hole_days=[days[-5], days[-3]])
+    s = _row(p, as_of=days[-4])
+    assert s["exclusion_code"] == "EXCL_SUSPENDED" and "視為仍停牌" in s["exclusion_reason"]
+    assert f"推定區間內 1 個交易日整個市場都缺行情（{days[-5]}～{days[-5]}）" in s["exclusion_reason"]
+    s2 = _row(p, as_of=days[-3])                   # 評估日本身缺全市場行情、本股無列 → 不算停牌
+    assert s2["exclusion_code"] == "EXCL_NO_ROW_SUSPENDED_OR_MISSING"
+
+
+def test_db_pipeline_columns_only_cross_check(tmp_path):
+    days = _days_fixture(tmp_path)
+    k = days[-3]
+    p = _db(tmp_path / "f", [(k, None)], drop=days[-3:])
+    con = sqlite3.connect(p)
+    cols = {r[1] for r in con.execute("PRAGMA table_info(trading_halts)")}
+    for c in ("resume_date_inferred", "resume_basis"):
+        if c not in cols:
+            con.execute(f"ALTER TABLE trading_halts ADD COLUMN {c} TEXT")
+    # 故意填與分析端不同的值：不得影響判定，只寫進 data_note
+    con.execute("UPDATE trading_halts SET resume_basis='inferred_by_trade', resume_date_inferred=? WHERE symbol=?", (days[-2], SYM))
+    con.commit()
+    con.close()
+    s = _row(p)
+    assert s["exclusion_code"] == "EXCL_SUSPENDED"
+    assert f"管線交叉檢查：resume_basis＝inferred_by_trade，resume_date_inferred＝{days[-2]}" in s["data_note"]
+
+
+def test_db_market_days_have_row_counts(tmp_path):
+    days = _days_fixture(tmp_path)
+    p = _db(tmp_path / "g", hole_days=[days[-1]])
+    inp = I.load_screen_inputs(p, as_of=days[-1])
+    md = inp.market_days.set_index(["market", "price_date"])["n_rows"]
+    assert md[("TWSE", days[-1])] < A.FULL_MARKET_MIN_ROWS <= md[("TWSE", days[-2])]
+
+
+def test_screen_without_row_counts_keeps_old_behaviour(tmp_path):
+    # 直接呼叫 screen() 且 market_days 沒有 n_rows 欄：market_days 內的日子都視為有全市場行情（舊行為）
+    days = _days_fixture(tmp_path)
+    p = _db(tmp_path / "h", [(days[-3], None)], drop=days[-3:], full_market=False)
+    inp = I.load_screen_inputs(p)
+    kw = inp.screen_kwargs()
+    kw["market_days"] = kw["market_days"][["market", "price_date"]]
+    s = S.screen(**kw).summary.set_index("symbol").loc[SYM]
+    assert s["exclusion_code"] == "EXCL_SUSPENDED"
