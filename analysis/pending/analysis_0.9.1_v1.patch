+之後一直沒有成交就視為仍停牌。只用評估日（含）以前的資料，不前視。"""
+import sqlite3
+
+import pandas as pd
+import pytest
+
+import adjust as A
+import io_sqlite as I
+import screener as S
+import synthetic_data as SD
+import verify_independent as VI
+
+T = pd.Timestamp
+AS_OF = "2026-10-05"
+SYM = "TEST01"            # 基準情境為 PASS 的合成股
+
+
+# ---------------- 純函式 ----------------
+def test_resolve_official_resume():
+    sp = A.resolve_halts([(T("2026-09-01"), T("2026-09-04"), None)], [T("2026-09-02")], T("2026-09-30"))
+    assert sp == [A.HaltSpan(T("2026-09-01"), T("2026-09-04"), A.HALT_SRC_OFFICIAL)]   # 官方恢復日優先於成交推定
+    assert A.is_halt_day(sp, T("2026-09-03")) and not A.is_halt_day(sp, T("2026-09-04"))
+    assert "官方恢復日 2026-09-04" in A.halt_note(sp[0])
+
+
+def test_resolve_no_resume_with_later_trade():
+    sp = A.resolve_halts([(T("2026-09-01"), None, None)], [T("2026-08-31"), T("2026-09-07"), T("2026-09-08")],
+                         T("2026-09-30"))
+    assert sp == [A.HaltSpan(T("2026-09-01"), T("2026-09-07"), A.HALT_SRC_TRADE)]
+    assert A.is_halt_day(sp, T("2026-09-04")) and not A.is_halt_day(sp, T("2026-09-07"))
+    assert A.halt_note(sp[0]) == "停牌日 2026-09-01，無官方恢復日，恢復日 2026-09-07（依成交推定）"
+
+
+def test_resolve_no_resume_never_traded():
+    sp = A.resolve_halts([(T("2026-09-01"), None, None)], [T("2026-08-31")], T("2026-09-30"))
+    assert sp == [A.HaltSpan(T("2026-09-01"), None, A.HALT_SRC_ONGOING)]
+    assert A.is_halt_day(sp, T("2026-09-30")) and "視為仍停牌" in A.halt_note(sp[0])
+
+
+def test_resolve_trade_on_halt_day_not_resume():
+    # 停牌日當天有成交列（例如盤中暫停交易）：恢復推定只看「停牌日之後」的成交
+    sp = A.resolve_halts([(T("2026-09-01"), None, None)], [T("2026-09-01"), T("2026-09-03")], T("2026-09-30"))
+    assert sp[0].resume == T("2026-09-03") and sp[0].source == A.HALT_SRC_TRADE
+    sp2 = A.resolve_halts([(T("2026-09-01"), None, None)], [T("2026-09-01")], T("2026-09-30"))
+    assert sp2[0].source == A.HALT_SRC_ONGOING
+
+
+def test_resolve_eval_day_before_and_after_inferred_resume():
+    rec, vd = [(T("2026-09-01"), None, None)], [T("2026-09-07")]
+    before = A.resolve_halts(rec, vd, T("2026-09-04"))           # 評估日在推定恢復日前：尚無成交 → 仍停牌
+    assert before[0].source == A.HALT_SRC_ONGOING and A.is_halt_day(before, T("2026-09-04"))
+    on = A.resolve_halts(rec, vd, T("2026-09-07"))               # 評估日＝推定恢復日：不算停牌
+    assert on[0].resume == T("2026-09-07") and not A.is_halt_day(on, T("2026-09-07"))
+    after = A.resolve_halts(rec, vd, T("2026-09-10"))
+    assert not A.is_halt_day(after, T("2026-09-10")) and A.is_halt_day(after, T("2026-09-04"))
+
+
+def test_resolve_no_lookahead():
+    # 評估日之後的成交（價量列或資料庫推得的恢復日）都不能用
+    sp = A.resolve_halts([(T("2026-09-01"), None, T("2026-09-10"))], [T("2026-09-10")], T("2026-09-08"))
+    assert sp[0].source == A.HALT_SRC_ONGOING and A.is_halt_day(sp, T("2026-09-08"))
+    assert A.resolve_halts([(T("2026-09-09"), None, None)], [], T("2026-09-08")) == []   # 停牌日晚於評估日：不採用
+    # 資料庫推得的恢復日（≤ as_of）可補足讀取窗口外的成交
+    sp2 = A.resolve_halts([(T("2026-01-02"), None, T("2026-01-05"))], [T("2026-09-01")], T("2026-09-08"))
+    assert sp2[0].resume == T("2026-01-05") and sp2[0].source == A.HALT_SRC_TRADE
+
+
+# ---------------- 合成資料庫情境（io_sqlite → screener，與 verify_independent 對照） ----------------
+def _days(p, as_of=AS_OF):
+    con = sqlite3.connect(p)
+    ds = [r[0] for r in con.execute("SELECT price_date FROM daily_prices WHERE symbol=? AND is_current=1 AND price_date<=? "
+                                    "ORDER BY price_date", (SYM, as_of))]
+    con.close()
+    return ds
+
+
+def _db(tmp_path, halts=(), drop=()):
+    tmp_path.mkdir(parents=True, exist_ok=True)
+    p = SD.build_sqlite(tmp_path / "h.db")
+    con = sqlite3.connect(p)
+    for d in drop:
+        con.execute("DELETE FROM daily_prices WHERE symbol=? AND price_date=?", (SYM, d))
+    for h, r in halts:
+        con.execute("INSERT INTO trading_halts (market, symbol, halt_date, resume_date, halt_type, source, fetched_at, "
+                    "version, is_current) VALUES ('TWSE', ?, ?, ?, '暫停交易', '測試用合成資料', '2026-10-05T18:00:00+08:00', 1, 1)",
+                    (SYM, h, r))
+    con.commit()
+    con.close()
+    return p
+
+
+def _row(p, as_of=AS_OF):
+    inp = I.load_screen_inputs(p, as_of=as_of)
+    s = S.screen(**inp.screen_kwargs()).summary.set_index("symbol").loc[SYM]
+    v = VI.recompute(VI.load_db(p, as_of=as_of), S.ScreenParams().to_dict(), [SYM])[SYM]
+    for f in ("status", "exclusion_code", "window_halt_days", "window_missing_days", "window_gap_days"):
+        if f in v:
+            assert (None if pd.isna(s[f]) else s[f]) == v[f], (f, s[f], v[f])
+    return s
+
+
+@pytest.fixture(scope="module")
+def days(tmp_path_factory):
+    return _days(SD.build_sqlite(tmp_path_factory.mktemp("d") / "d.db"))
+
+
+def test_db_official_resume(tmp_path, days):
+    k = days[-10]
+    s = _row(_db(tmp_path, [(k, days[-8])], drop=days[-10:-8]))
+    assert s["status"] == "PASS" and s["window_halt_days"] == 2 and s["window_missing_days"] == 0
+    assert f"停牌日 {k}，官方恢復日 {days[-8]}" in s["data_note"]
+
+
+def test_db_no_resume_inferred_from_trade(tmp_path, days):
+    # 停牌日後 2 日無列，之後恢復成交；再過幾天另有 1 日無列 → 新規則只算 2 日停牌，另 1 日是缺漏
+    k = days[-10]
+    s = _row(_db(tmp_path, [(k, None)], drop=days[-10:-8] + [days[-5]]))
+    assert (s["window_halt_days"], s["window_missing_days"], s["window_gap_days"]) == (2, 1, 3)
+    assert s["status"] == "PASS"
+    assert f"停牌日 {k}，無官方恢復日，恢復日 {days[-8]}（依成交推定）" in s["data_note"]
+
+
+def test_db_no_resume_never_traded_is_suspended(tmp_path, days):
+    k = days[-3]
+    s = _row(_db(tmp_path, [(k, None)], drop=days[-3:]))
+    assert s["exclusion_code"] == "EXCL_SUSPENDED"
+    assert "無官方恢復日，停牌日後至評估日無官方成交，視為仍停牌" in s["exclusion_reason"]
+
+
+def test_db_old_halt_with_later_trades_not_suspended(tmp_path, days):
+    # 11-17 的 12 檔情境：很久以前的停牌紀錄沒有恢復日，之後一直有成交；評估日沒有資料列 → 不再判確認停牌
+    s = _row(_db(tmp_path, [(days[5], None)], drop=[days[-1]]))
+    assert s["exclusion_code"] == "EXCL_NO_ROW_SUSPENDED_OR_MISSING"
+    assert f"恢復日 {days[6]}（依成交推定）" in s["data_note"]
+
+
+def test_db_halt_day_has_trade_row(tmp_path, days):
+    k = days[-1]                                  # 停牌日＝評估日，當天有成交列 → 照常評估
+    s = _row(_db(tmp_path, [(k, None)]))
+    assert s["status"] == "PASS" and s["window_halt_days"] == 0
+    k2 = days[-3]                                 # 停牌日當天有成交，隔天起無列至評估日 → 仍停牌
+    s2 = _row(_db(tmp_path / "b", [(k2, None)], drop=days[-2:]))
+    assert s2["exclusion_code"] == "EXCL_SUSPENDED"
+
+
+def test_db_eval_day_before_after_inferred_resume_and_no_lookahead(tmp_path, days):
+    k, r = days[-10], days[-7]
+    p = _db(tmp_path, [(k, None)], drop=days[-10:-7])
+    s_before = _row(p, as_of=days[-8])           # 評估日在推定恢復日之前（資料庫裡之後有成交，但不能前視）
+    assert s_before["exclusion_code"] == "EXCL_SUSPENDED" and "視為仍停牌" in s_before["exclusion_reason"]
+    s_on = _row(p, as_of=r)                      # 評估日＝第一個成交日 → 照常評估，停牌 3 日
+    assert s_on["exclusion_code"] != "EXCL_SUSPENDED"
+    assert s_on["window_halt_days"] == 3 and f"恢復日 {r}（依成交推定）" in s_on["data_note"]
+
+
+def test_db_vi_full_agreement(tmp_path, days):
+    p = _db(tmp_path, [(days[-10], None), (days[5], None)], drop=days[-10:-8] + [days[-5]])
+    assert VI.run_comparison(p, n_dates=3)["mismatches"] == []
