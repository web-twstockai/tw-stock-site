+"""DECISIONS 2026-11-10 12:05 核可三項（整股無成交日相關）測試——只用測試用合成資料。
+① 有收盤價但成交量 NULL＝資料錯誤（評估日與視窗內皆是）；
+② 無成交日的次一有效交易日 change_check＝after_no_trade（有官方參考價才比對；X 顯示「無比價」）；
+③ is_no_trade 只在說明欄（data_note）交叉檢查，不改結果碼。"""
+import sqlite3
+
+import pandas as pd
+import pytest
+
+import adjust as A
+import io_sqlite as I
+import screener as S
+import series as SR
+import synthetic_data as SD
+import verify_independent as VI
+import writer as W
+
+AS_OF, PREV, PREV2 = "2026-10-05", "2026-10-02", "2026-10-01"
+
+
+# ---------------- 純函式 ----------------
+def test_row_kind():
+    assert A.row_kind(10.0, 1000) == "valid"
+    assert A.row_kind(10.0, None) == "bad_volume" and A.row_kind(10.0, float("nan")) == "bad_volume"
+    assert A.row_kind(None, 0) == "no_trade" and A.row_kind(None, 5) == "no_trade"      # 只有零股成交
+    assert A.row_kind(10.0, 0) == "no_trade" and A.row_kind(None, None) == "no_trade"
+
+
+def test_no_trade_flag_conflict():
+    assert A.no_trade_flag_conflict(10.0, 1000, 1) == "is_no_trade＝1 但價量顯示有成交"
+    assert A.no_trade_flag_conflict(None, 0, 0).startswith("is_no_trade＝0 但價量顯示整股無成交")
+    assert A.no_trade_flag_conflict(10.0, 1000, 0) is None and A.no_trade_flag_conflict(None, 0, 1) is None
+    assert A.no_trade_flag_conflict(10.0, 1000, None) is None                    # 旗標未知不比對
+    assert A.no_trade_flag_conflict(10.0, None, 1) is None                       # 資料錯誤列不比對
+
+
+def test_check_change_after_no_trade_pure():
+    f = A.check_change_after_no_trade
+    st, src, diff, tol, note = f(11.60, 11.00, None, "X")
+    assert (st, src, diff) == ("after_no_trade", None, None) and note.startswith("無比價")
+    st, *_, note = f(11.60, 11.00, None, None, change_note="無比價")
+    assert st == "after_no_trade" and "無比價" in note
+    # TPEx 2064 實例數字（官方次日參考價 10.95、漲跌 +0.65）：有參考價→一致
+    st, src, diff, tol, note = f(11.60, 11.00, 0.65, "+", official_ref=10.95)
+    assert st == "after_no_trade" and src == pytest.approx(0.65) and abs(diff) < 1e-9 and tol == 0.005
+    assert "依官方參考價 10.95 比對一致" in note
+    st, _, diff, _, note = f(11.60, 11.00, 0.65, "+", official_ref=10.90)
+    assert st == "mismatch" and diff == pytest.approx(0.05) and "不一致" in note
+    # 無官方參考價：不比對、不算 mismatch，列出隱含參考價
+    st, src, diff, tol, note = f(11.60, 11.00, 0.65, "+")
+    assert (st, diff, tol) == ("after_no_trade", None, None) and "隱含參考價 10.95" in note
+    assert f(11.60, 11.00, 0.65, "-")[0] == "after_no_trade"                    # 帶號 −0.65
+    assert f(11.60, 11.00, -0.65, "+")[0] == "source_sign_conflict"
+    st, *_, note = f(11.60, 11.00, None, None)
+    assert st == "after_no_trade" and "官方未提供漲跌" in note
+    assert "after_no_trade" in A.CHANGE_CHECK_STATUSES
+
+
+# ---------------- 合成資料庫情境 ----------------
+def _db(tmp_path, sql=(), add_cols=True):
+    tmp_path.mkdir(parents=True, exist_ok=True)
+    p = SD.build_sqlite(tmp_path / "nt.db")
+    con = sqlite3.connect(p)
+    have = {r[1] for r in con.execute("PRAGMA table_info(daily_prices)")}
+    if add_cols:
+        for c, t in (("is_no_trade", "INTEGER"), ("change_note", "TEXT"), ("next_ref_price_twd", "REAL")):
+            if c not in have:
+                con.execute(f"ALTER TABLE daily_prices ADD COLUMN {c} {t}")
+    for q, args in sql:
+        con.execute(q, args)
+    con.commit()
+    con.close()
+    return p
+
+
+def _upd(sym, d, **kv):
+    return (f"UPDATE daily_prices SET {', '.join(f'{k} = ?' for k in kv)} WHERE symbol = ? AND price_date = ?",
+            [*kv.values(), sym, d])
+
+
+NO_TRADE = dict(open_twd=None, high_twd=None, low_twd=None, close_twd=None, volume_shares=0, amount_twd=0,
+                change_twd=None, change_sign=None)
+
+
+def _summary(p, as_of=AS_OF, **kw):
+    inp = I.load_screen_inputs(p, as_of=as_of)
+    return S.screen(**inp.screen_kwargs(), **kw).summary.set_index("symbol")
+
+
+def _vi(p, as_of=AS_OF):
+    data = VI.load_db(p, as_of=as_of)
+    return VI.recompute(data, S.ScreenParams().to_dict(), sorted(data["secs"]))
+
+
+def test_bad_volume_in_window_is_bad_data(tmp_path):
+    base = _summary(_db(tmp_path / "a"))
+    assert base.loc["TEST01", "status"] == "PASS"
+    p = _db(tmp_path / "b", [_upd("TEST01", "2026-09-28", volume_shares=None)])   # 視窗內：有收盤、量 NULL
+    s = _summary(p).loc["TEST01"]
+    assert s["exclusion_code"] == "EXCL_BAD_DATA" and "有收盤價但成交量缺漏（NULL）（視窗內" in s["exclusion_reason"]
+    assert (s["window_bad_data_days"], s["window_no_trade_days"], s["window_gap_days"]) == (1, 0, 1)   # 合計不變
+    v = _vi(p)["TEST01"]
+    assert v["exclusion_code"] == "EXCL_BAD_DATA" and v["window_bad_data_days"] == 1 and v["window_gap_days"] == 1
+
+
+def test_bad_volume_counts_in_gap_total_first(tmp_path):
+    # 缺口合計仍先判（與門檻比較的口徑不變）：4 日量 NULL → 合計 4 > 3 → EXCL_WINDOW_GAPS
+    days = ["2026-09-22", "2026-09-23", "2026-09-24", "2026-09-25"]
+    s = _summary(_db(tmp_path, [_upd("TEST01", d, volume_shares=None) for d in days])).loc["TEST01"]
+    assert s["exclusion_code"] == "EXCL_WINDOW_GAPS" and s["window_bad_data_days"] == 4 and s["window_gap_days"] == 4
+
+
+def test_bad_volume_on_as_of(tmp_path):
+    p = _db(tmp_path, [_upd("TEST01", AS_OF, volume_shares=None, is_halted=1)])
+    s = _summary(p).loc["TEST01"]
+    assert s["exclusion_code"] == "EXCL_BAD_DATA" and "有收盤價但成交量缺漏（NULL）" in s["exclusion_reason"]
+    assert _vi(p)["TEST01"]["exclusion_code"] == "EXCL_BAD_DATA"
+
+
+def test_series_mark_bad_volume(tmp_path):
+    p = _db(tmp_path, [_upd("TEST01", "2026-09-28", volume_shares=None)])
+    kw = I.load_symbol_inputs(p, "TEST01", as_of=AS_OF)
+    m = SR.ma_series(**kw).set_index("price_date").loc[pd.Timestamp("2026-09-28")]
+    assert m["status"] == "no_trade" and m["unavailable_code"] == "EXCL_BAD_DATA"
+    b = SR.ohlc_series(**kw).bars.set_index("price_date").loc[pd.Timestamp("2026-09-28")]
+    assert b["status"] == "no_trade" and b["unavailable_reason"] == SR.BAD_VOLUME_REASON
+    ok = SR.ma_series(**kw).set_index("price_date").loc[pd.Timestamp("2026-09-29")]
+    assert ok["status"] == "ok"
+
+
+def test_after_no_trade_without_official_ref(tmp_path):
+    p = _db(tmp_path, [_upd("TEST01", PREV, **NO_TRADE)])
+    s = _summary(p).loc["TEST01"]
+    assert s["change_check"] == "after_no_trade" and pd.isna(s["change_check_diff_twd"])
+    assert "前一交易日整股無成交" in s["data_note"] and "隱含參考價" in s["data_note"]
+    kw = I.load_symbol_inputs(p, "TEST01", as_of=AS_OF)
+    c = SR.change_series(**kw).set_index("price_date").loc[pd.Timestamp(AS_OF)]
+    assert c["change_check"] == "after_no_trade" and c["prev_price_date"] == pd.Timestamp(PREV2)
+    assert c["change_base_twd"] == pytest.approx(c["prev_close_twd"])          # 自算基準仍為前一有效收盤
+    assert VI.run_comparison(p, n_dates=3)["mismatches"] == []
+    assert VI.run_series_comparison(p, n_dates=1)["mismatches"] == []
+
+
+def test_after_no_trade_with_official_ref(tmp_path):
+    con = sqlite3.connect(_db(tmp_path / "x"))
+    close, chg = con.execute("SELECT close_twd, change_twd FROM daily_prices WHERE symbol='TEST01' AND price_date=? AND is_current=1",
+                             (AS_OF,)).fetchone()
+    con.close()
+    good = round(close - chg, 2)                                                # 與來源漲跌一致的參考價
+    p1 = _db(tmp_path / "g", [_upd("TEST01", PREV, **NO_TRADE, next_ref_price_twd=good)])
+    s = _summary(p1).loc["TEST01"]
+    assert s["change_check"] == "after_no_trade" and abs(s["change_check_diff_twd"]) <= 0.005
+    assert f"依官方參考價 {good:.2f} 比對一致" in s["data_note"]
+    p2 = _db(tmp_path / "b", [_upd("TEST01", PREV, **NO_TRADE, next_ref_price_twd=good - 0.5)])
+    s2 = _summary(p2).loc["TEST01"]
+    assert s2["change_check"] == "mismatch" and s2["change_check_diff_twd"] == pytest.approx(0.5)
+    assert _vi(p2)["TEST01"]["change_check"] == "mismatch" and _vi(p1)["TEST01"]["change_check"] == "after_no_trade"
+
+
+def test_after_no_trade_twse_x_shows_no_compare(tmp_path):
+    p = _db(tmp_path, [_upd("TEST01", PREV, **NO_TRADE),
+                       _upd("TEST01", AS_OF, change_twd=None, change_sign="X", change_note="無比價")])
+    s = _summary(p).loc["TEST01"]
+    assert s["change_check"] == "after_no_trade" and s["data_note"].startswith("無比價")
+    assert pd.isna(s["source_change_twd"])
+    assert _vi(p)["TEST01"]["change_check"] == "after_no_trade"
+
+
+def test_x_without_prior_no_trade_unchanged(tmp_path):
+    # 前一交易日有成交時維持原規則（本批不改）：X 且有數值→source_not_comparable；X 且數值 NULL→no_source（既有行為）
+    p = _db(tmp_path / "a", [_upd("TEST01", AS_OF, change_twd=0.0, change_sign="X")])
+    s = _summary(p).loc["TEST01"]
+    assert s["change_check"] == "source_not_comparable" and pd.isna(s["data_note"])
+    p = _db(tmp_path / "b", [_upd("TEST01", AS_OF, change_twd=None, change_sign="X")])
+    assert _summary(p).loc["TEST01", "change_check"] == "no_source"
+
+
+def test_is_no_trade_cross_check_only_annotates(tmp_path):
+    base = _summary(_db(tmp_path / "a"))
+    p = _db(tmp_path / "b", [_upd("TEST01", AS_OF, is_no_trade=1), _upd("TEST01", "2026-09-28", is_no_trade=1),
+                             _upd("TEST12", AS_OF, is_no_trade=0), _upd("TEST02", AS_OF, is_no_trade=0)])
+    s = _summary(p)
+    for sym in ("TEST01", "TEST12", "TEST02"):
+        assert (s.loc[sym, "status"], s.loc[sym, "exclusion_code"]) == (base.loc[sym, "status"], base.loc[sym, "exclusion_code"])
+    assert f"is_no_trade 交叉檢查：{AS_OF} is_no_trade＝1 但價量顯示有成交" in s.loc["TEST01", "data_note"]
+    assert "視窗內 1 日旗標與價量不一致（首日 2026-09-28）" in s.loc["TEST01", "data_note"]
+    assert s.loc["TEST12", "exclusion_code"] == "EXCL_NO_TRADE" and "is_no_trade＝0" in s.loc["TEST12", "data_note"]
+    assert pd.isna(s.loc["TEST02", "data_note"])                               # 一致：不標註
+    kw = I.load_symbol_inputs(p, "TEST01", as_of=AS_OF)
+    c = SR.change_series(**kw).set_index("price_date").loc[pd.Timestamp(AS_OF)]
+    assert "is_no_trade 交叉檢查" in c["note"] and c["status"] == "ok"
+
+
+def test_missing_optional_columns_tolerated(tmp_path):
+    p = _db(tmp_path, [_upd("TEST01", PREV, open_twd=None, high_twd=None, low_twd=None, close_twd=None,
+                            volume_shares=0, amount_twd=0)], add_cols=False)
+    s = _summary(p).loc["TEST01"]
+    assert s["change_check"] == "after_no_trade"
+
+
+def _sr_db(path, allow_after=True):
+    import re
+    ddl = re.search(r"```sql\n(.*?)```", (SD.HERE.parent / "tables_draft.md").read_text(encoding="utf-8"), re.S).group(1)
+    ddl = ddl.replace("CHECK (symbol NOT LIKE 'TEST%')", "")
+    if not allow_after:
+        ddl = ddl.replace(", 'after_no_trade'", "")          # 模擬資料庫 CHECK 尚未遷移
+    path.mkdir(parents=True, exist_ok=True)
+    c = sqlite3.connect(path / "analysis_tables.db")
+    c.executescript(ddl)
+    c.close()
+    return W.connect_writable(path / "analysis_tables.db")
+
+
+def test_writer_guards_change_check_constraint(tmp_path):
+    p = _db(tmp_path, [_upd("TEST01", PREV, **NO_TRADE)])
+    inp = I.load_screen_inputs(p, as_of=AS_OF)
+    r = S.screen(**inp.screen_kwargs())
+    old = _sr_db(tmp_path / "old", allow_after=False)
+    with pytest.raises(ValueError, match="after_no_trade"):
+        W.write_screen_results(old, r, inp.input_max_fetched_at)
+    assert old.execute("SELECT COUNT(*) FROM screen_results").fetchone()[0] == 0          # 一列都不寫
+    new = _sr_db(tmp_path / "new")
+    rep = W.write_screen_results(new, r, inp.input_max_fetched_at)
+    assert rep.dropped_columns == [] and rep.inserted == len(r.summary)
+    row = new.execute("SELECT change_check, data_note, window_bad_data_days FROM screen_results "
+                      "WHERE symbol='TEST01'").fetchone()
+    assert row[0] == "after_no_trade" and "前一交易日整股無成交" in row[1] and row[2] == 0
