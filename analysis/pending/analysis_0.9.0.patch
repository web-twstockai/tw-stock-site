+"""analysis-0.9.0：量額口徑 volume_basis（docs/indicators.md §9；負責人 2026-11-17 16:09 核可，方案 A）。
+只用測試用合成資料（代號 TEST*）。規則：只認 incl_block 為總量；excl_block／NULL／其他值都不是總量。
+5a＝評估日（C3 或 C4 啟用時）；9a＝均量窗口（評估日前 volume_lookback 個有效交易日；C3 啟用時排除，否則只記數）。"""
+import re
+import sqlite3
+
+import pandas as pd
+import pytest
+
+import adjust as A
+import io_sqlite as I
+import screener as S
+import series as SR
+import synthetic_data as SD
+import verify_independent as VI
