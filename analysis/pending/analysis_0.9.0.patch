+import writer as W
+
+AS_OF = "2026-10-05"
+IN_WIN = "2026-09-28"          # 評估日前第 5 個有效交易日（在均量窗口內）
+
+
+def _db(tmp_path, sql=(), **kw):
+    tmp_path.mkdir(parents=True, exist_ok=True)
+    p = SD.build_sqlite(tmp_path / "vb.db", **kw)
+    con = sqlite3.connect(p)
+    for q, args in sql:
+        con.execute(q, args)
+    con.commit()
+    con.close()
+    return p
+
+
+def _vb(sym, d, v):
+    return ("UPDATE daily_prices SET volume_basis = ? WHERE symbol = ? AND price_date = ?", [v, sym, d])
+
+
+def _summary(p, as_of=AS_OF, **kw):
+    inp = I.load_screen_inputs(p, as_of=as_of)
+    r = S.screen(**inp.screen_kwargs(), **kw)
+    return inp, r, r.summary.set_index("symbol")
+
+
+def _valid_days(p, sym, as_of=AS_OF):
+    con = sqlite3.connect(p)
+    ds = [r[0] for r in con.execute(
+        "SELECT price_date FROM daily_prices WHERE symbol=? AND is_current=1 AND price_date<=? AND close_twd IS NOT NULL "
+        "AND volume_shares>0 ORDER BY price_date", (sym, as_of))]
+    con.close()
+    return ds
+
+
+def _sr_db(path):
+    ddl = re.search(r"```sql\n(.*?)```", (SD.HERE.parent / "tables_draft.md").read_text(encoding="utf-8"), re.S).group(1)
+    ddl = ddl.replace("CHECK (symbol NOT LIKE 'TEST%')", "")
+    path.mkdir(parents=True, exist_ok=True)
+    c = sqlite3.connect(path / "analysis_tables.db")
+    c.executescript(ddl)
+    c.close()
+    return W.connect_writable(path / "analysis_tables.db")
+
+
+# ---------------- 純函式與常數 ----------------
+def test_version_and_codes():
+    assert V.ANALYSIS_VERSION == "analysis-0.9.0" == S.ANALYSIS_VERSION
+    assert "EXCL_VOLUME_BASIS" in S.EXCLUSION_CODES
+    i = list(S.SUMMARY_COLUMNS).index
+    assert i("window_bad_data_days") < i("volume_basis") < i("window_volume_basis_days")
+    assert {"volume_basis", "window_volume_basis_days"} <= set(S.SUMMARY_COLUMNS)
+
+
+def test_is_total_basis():
+    assert A.is_total_basis("incl_block")
+    for v in ("excl_block", None, float("nan"), "", "INCL_BLOCK", "other"):
+        assert not A.is_total_basis(v), v
+    assert A.VOLUME_BASIS_COLUMN_MISSING == "volume_basis_column_missing"
+
+
+# ---------------- 合成資料庫情境 ----------------
