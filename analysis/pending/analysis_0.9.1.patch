+++ b/analysis/tests/test_narrative_fullmarket.py	2026-11-17 18:39:27.955938003 +0800
@@ -0,0 +1,93 @@
+"""analysis-0.9.1：全市場每日摘要寫法（narrative.summary_narrative）。只用測試用合成資料。
+驗證摘要中的檔數與結果表（ScreenResult.summary）一致、排除原因中文分類、落後註記、缺 volume_basis 研究註記、零結果與免責。"""
+import re
+from dataclasses import replace
+
+import pandas as pd
+
+import narrative as N
+import screener as S
+
+CAUSAL = ("因為", "由於", "受惠", "帶動", "利多", "利空", "導致", "推升", "拖累", "看好", "預期將", "勝率", "保證", "獲利")
+HEAD = re.compile(r"^(\S+) (\d+) 檔／實際完成條件評估 (\d+) 檔／符合 (\d+) 檔／未納入評估 (\d+) 檔（完成評估但未符合 (\d+) 檔）。$", re.M)
+
+
+def _res(T, **kw):
+    a = dict(prices=T["daily_prices"], calendar=T["trading_calendar"], actions=T["corporate_actions"],
+             securities=T["securities"], actions_coverage=T["actions_coverage"], halts=T["trading_halts"])
+    a.update(kw)
+    return S.screen(**a)
+
+
+def _check_counts(n, r, label="全市場"):
+    s = r.summary
+    m = HEAD.search(n.text)
+    assert m, n.text
+    assert m.group(1) == label
+    N_, M, K, X, F = map(int, m.groups()[1:])
+    assert N_ == len(s) and K == int((s.status == "PASS").sum()) and F == int((s.status == "FAIL").sum())
+    assert M == K + F and X == int((s.status == "EXCLUDED").sum()) and N_ == M + X
+    counts = r.exclusion_counts()
+    got = {}
+    for name, codes in N.EXCLUSION_GROUPS:
+        mm = re.search(rf"^- {re.escape(name)}：(\d+) 檔$", n.text, re.M)
+        exp = sum(counts.get(c, 0) for c in codes)
+        if exp:
+            assert mm and int(mm.group(1)) == exp, (name, exp)
+            got[name] = exp
+        else:
+            assert mm is None, name
+    assert sum(got.values()) == X
+    assert N.untraceable_numbers(n.text, n.facts) == []
+    assert N.DISCLAIMER in n.text and not any(w in n.text.replace(N.DISCLAIMER, "") for w in CAUSAL)
+
+
+def test_groups_cover_every_code_once():
+    flat = [c for _, cs in N.EXCLUSION_GROUPS for c in cs]
+    assert sorted(flat) == sorted(S.EXCLUSION_CODES) and len(flat) == len(set(flat))
+    assert all(re.search(r"[\u4e00-\u9fff]", g) for g, _ in N.EXCLUSION_GROUPS)
+
+
+def test_counts_match_result_table(T):
+    r = _res(T)
+    _check_counts(N.summary_narrative(r), r)
+
+
+def test_zero_result_and_many_excluded(T):
+    r = _res(T, actions_coverage=None)            # 無覆蓋表 → strict 幾乎全數排除，不放寬
+    n = N.summary_narrative(r)
+    _check_counts(n, r)
+    assert "今日 0 檔符合全部已啟用條件；不放寬條件找替代股。" in n.text
+    assert "- 除權息／減資資料或調整因子問題：" in n.text
+
+
+def test_lagging_note(T):
+    r = _res(T)
+    s_px = T["daily_prices"]
+    cal = T["trading_calendar"]
+    trade = set(cal.loc[cal.is_trade_day == 1, "calendar_date"])
+    cur = s_px[(s_px.is_current == 1) & s_px.price_date.isin(trade) & (s_px.price_date <= str(r.as_of.date()))]
+    latest = cur.groupby("symbol").price_date.max()
+    exp = sorted(sym for sym in r.summary.symbol if latest.get(sym) != str(r.as_of.date()))
+    assert list(r.lagging_symbols) == exp and exp
+    n = N.summary_narrative(r)
+    assert f"另有 {len(exp)} 檔{N.LAGGING_NOTE}" in n.text
+    n0 = N.summary_narrative(replace(r, lagging_symbols=()))
+    assert N.LAGGING_NOTE not in n0.text
+
+
+def test_research_note_when_volume_basis_missing(T):
+    r_ok = _res(T)
+    assert r_ok.volume_basis_status == "ok" and N.RESEARCH_NOTE not in N.summary_narrative(r_ok).text
+    r = _res(T, prices=T["daily_prices"].drop(columns=["volume_basis"]))
+    assert r.volume_basis_status == "volume_basis_column_missing"
+    n = N.summary_narrative(r)
+    assert N.RESEARCH_NOTE in n.text
+    _check_counts(n, r)
+
+
+def test_scope_label(T):
+    r = _res(T)
+    n = N.summary_narrative(r, scope_label="追蹤範圍")
+    _check_counts(n, r, label="追蹤範圍")
+    assert "全市場" not in n.text
